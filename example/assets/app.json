    "/profile": {
      "type": "scaffold",
      "appBar": {
        "type": "appBar",
        "title": "Your profile",
        "actions": [
          {
            "type": "iconButton",
            "icon": "info",
            "tooltip": "About SpaceWidget",
            "action": {
              "type": "dialog",
              "content": {
                "type": "alertDialog",
                "title": "Built from JSON",
                "text": "Every screen in this app is rendered by SpaceWidget. Custom Dart handlers connect your backend.",
                "actions": [
                  {
                    "type": "textButton",
                    "text": "Got it",
