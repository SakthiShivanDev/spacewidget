      "body": {
        "type": "safeArea",
        "child": {
          "type": "padding",
          "padding": 24,
          "child": {
            "type": "listView",
            "children": [
              {
                "type": "text",
                "text": "Make it yours",
                "fontSize": 22,
                "fontWeight": 700
              },
              {
                "type": "sizedBox",
                "height": 8
              },
              {
                "type": "text",
                "text": "Validated forms with state that survives rebuilds.",
                "color": "#64748B"
              },
              {
                "type": "sizedBox",
                "height": 24
              },
              {
                "type": "form",
                "id": "profile",
                "children": [
                  {
                    "type": "input",
                    "name": "name",
                    "bind": "user.name",
                    "label": "Display name",
                    "required": true,
                    "minLength": 2
                  },
                  {
                    "type": "sizedBox",
                    "height": 16
                  },
                  {
                    "type": "input",
                    "name": "email",
                    "bind": "user.email",
                    "label": "Email address",
                    "required": true,
                    "email": true,
                    "keyboardType": "email"
                  },
                  {
                    "type": "sizedBox",
                    "height": 16
                  },
                  {
                    "type": "dropdown",
                    "name": "role",
                    "label": "Role",
                    "initialValue": "developer",
                    "options": [
                      {
                        "label": "Developer",
                        "value": "developer"
                      },
                      {
                        "label": "Designer",
                        "value": "designer"
                      },
                      {
                        "label": "Product manager",
                        "value": "product"
                      }
                    ]
                  },
                  {
                    "type": "sizedBox",
                    "height": 16
                  },
                  {
                    "type": "textArea",
                    "name": "bio",
                    "label": "About you",
                    "hint": "Tell your team a little about yourself"
                  },
                  {
                    "type": "sizedBox",
                    "height": 16
                  },
                  {
                    "type": "switch",
                    "name": "notifications",
                    "label": "Email notifications",
                    "initialValue": true
                  },
                  {
                    "type": "sizedBox",
                    "height": 16
                  },
                  {
                    "type": "filledButton",
                    "text": "Save profile",
                    "action": {
                      "type": "submit",
                      "form": "profile",
                      "name": "saveProfile"
                    }
                  }
                ]
              }
            ]
          }
