# Run npm run configure to generate fresh local secrets.
STUDIO_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
STUDIO_SETUP_TOKEN=REPLACE_WITH_RANDOM_SETUP_TOKEN
STUDIO_ORIGIN=http://localhost:4100
PORT=4100
HOST=127.0.0.1
STUDIO_DATABASE_URL=postgresql://studio:CHANGE_ME@localhost:5432/spacewidget
STUDIO_DATABASE_SCHEMA=spacewidget
# Remote PostgreSQL uses verified TLS by default; local development may set false.
# STUDIO_DATABASE_TLS=true
# STUDIO_DATABASE_CA=-----BEGIN CERTIFICATE-----...
STUDIO_DATA_DIR=data
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=SpaceWidget <noreply@example.com>
# Comma-separated PostgreSQL hosts this deployment permits connectors to reach.
# Production requires an explicit list; allow only your own database hosts.
# STUDIO_DB_HOSTS=postgres,db.example.com
# Trusted reverse-proxy IP addresses/CIDRs (comma-separated). Default trusts none.
# Compose trusts private container peers and keeps the app port private.
# STUDIO_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Optional PostgreSQL app-data connection. In Studio: Data > Connect database >
# Connection settings > Use APP_DATABASE_URL. The URL never enters browser JSON.
# DATABASE_URL is also accepted as a fallback for hosting platforms.
# APP_DATABASE_URL=postgresql://app_user:password@db.example.com:5432/app?sslmode=verify-full
# APP_DATABASE_TLS=true
# APP_DATABASE_CA=-----BEGIN CERTIFICATE-----...

# Explicit local simulation only. Ignored when NODE_ENV=production.
# SPACE_DEMO_PAYMENTS=true
# Live/test Stripe secrets are server-only. Never compile them into Flutter.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_RETURN_URL=https://app.example.com/payment-return
# Webhook: POST https://studio.example.com/integrations/stripe/<app-id>/webhook

# Google OIDC authorization-code flow. Callback is registered in Google Cloud.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_CALLBACK_URL=https://studio.example.com/integrations/google/callback
# SPACE_AUTH_RETURN_URLS=https://app.example.com/auth-return,spacewidget://app/auth-return

# Firebase service-account JSON is server-only (one line, quoted as needed).
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}

# HTTP service connections may contact only explicitly approved origins.
# STUDIO_HTTP_HOSTS=api.example.com
# STUDIO_HTTP_ALLOW_LOCALHOST=false

# Select the default hosted payment provider and store currency BEFORE adding products.
# The currency describes your stored minor-unit prices; it does not convert them.
# PAYMENT_PROVIDER=stripe
# PAYMENT_CURRENCY=usd
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# RAZORPAY_RETURN_URL=https://app.example.com/payment-return
# Webhook: POST /integrations/razorpay/<app-id>/webhook

# Sign in with Apple (web Services ID and Apple Developer key).
# APPLE_CLIENT_ID=...
# APPLE_TEAM_ID=...
# APPLE_KEY_ID=...
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_CALLBACK_URL=https://studio.example.com/integrations/apple/callback
# Add the same app destinations to SPACE_AUTH_RETURN_URLS.

# AI keys are configured per Studio builder in AI design, encrypted with
# STUDIO_MASTER_KEY. They are never compiled into Flutter or published JSON.
